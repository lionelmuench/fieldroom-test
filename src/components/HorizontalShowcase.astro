---
// HorizontalShowcase.astro - The wow factor horizontal scroll section
---

<section class="horizontal-wrapper relative" id="process">
  <!-- Sticky header that stays while scrolling -->
  <div class="sticky top-0 z-10 bg-paper/90 backdrop-blur-sm py-6 px-6 border-b border-paper-dark">
    <div class="max-w-6xl mx-auto flex items-center justify-between">
      <h2 class="text-2xl md:text-3xl font-semibold text-ink-dark">
        How we <span class="font-sketch text-3xl md:text-4xl text-pencil">work</span>
      </h2>
      <div class="hidden md:flex items-center gap-2 text-ink-light">
        <span class="font-sketch text-lg">keep scrolling</span>
        <svg class="w-6 h-4" viewBox="0 0 24 16" fill="none">
          <path d="M4 8h12M12 3l5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
    </div>
  </div>

  <!-- Horizontal scroll container -->
  <div class="horizontal-section">
    <div class="horizontal-container" id="horizontal-panels">
      
      <!-- Panel 1: Design -->
      <div class="horizontal-panel bg-paper">
        <div class="max-w-lg text-center md:text-left">
          <div class="inline-block mb-6 px-4 py-2 bg-highlight/50 rounded-full">
            <span class="font-sketch text-xl">01</span>
          </div>
          <h3 class="text-4xl md:text-5xl font-semibold mb-6 text-ink-dark">Design</h3>
          <p class="text-lg text-ink-light leading-relaxed mb-8">
            We start with a conversation. Understanding your brand, your audience, and your goals. Then we sketch - literally - bringing ideas to life on paper before pixels.
          </p>
          <!-- Sketch illustration -->
          <svg class="w-full max-w-sm h-48 mx-auto md:mx-0" viewBox="0 0 300 180" fill="none">
            <!-- Mockup frame -->
            <rect class="draw-path" data-horizontal x="20" y="20" width="260" height="140" rx="4" stroke="#2A2A2A" stroke-width="2" fill="none"/>
            <!-- Header bar -->
            <path class="draw-path" data-horizontal d="M20 50 L280 50" stroke="#2A2A2A" stroke-width="1.5"/>
            <!-- Content blocks -->
            <rect class="draw-path" data-horizontal x="40" y="70" width="80" height="60" rx="2" stroke="#B8C5D6" stroke-width="2" fill="none"/>
            <path class="draw-path" data-horizontal d="M140 70 L260 70 M140 90 L220 90 M140 110 L240 110" stroke="#E8D4D4" stroke-width="2" stroke-linecap="round"/>
            <!-- Pencil -->
            <path class="draw-path" data-horizontal d="M220 140 L260 100 L270 110 L230 150 Z" stroke="#2A2A2A" stroke-width="1.5" fill="none"/>
          </svg>
        </div>
      </div>
      
      <!-- Panel 2: Develop -->
      <div class="horizontal-panel bg-paper-cream">
        <div class="max-w-lg text-center md:text-left">
          <div class="inline-block mb-6 px-4 py-2 bg-pencil/20 rounded-full">
            <span class="font-sketch text-xl">02</span>
          </div>
          <h3 class="text-4xl md:text-5xl font-semibold mb-6 text-ink-dark">Develop</h3>
          <p class="text-lg text-ink-light leading-relaxed mb-8">
            Clean code, modern tech, zero bloat. Every site is hand-built with performance in mind. We use static site generation for blazing-fast load times.
          </p>
          <!-- Code illustration -->
          <div class="bg-ink-dark text-paper-light p-6 rounded-lg font-mono text-sm max-w-sm mx-auto md:mx-0 text-left">
            <div class="flex items-center gap-2 mb-4">
              <span class="w-3 h-3 rounded-full bg-eraser"></span>
              <span class="w-3 h-3 rounded-full bg-highlight"></span>
              <span class="w-3 h-3 rounded-full bg-pencil"></span>
            </div>
            <pre class="text-xs md:text-sm leading-relaxed overflow-x-auto"><code><span class="text-pencil">const</span> website = &lbrace;
  <span class="text-highlight">fast</span>: <span class="text-eraser">true</span>,
  <span class="text-highlight">beautiful</span>: <span class="text-eraser">true</span>,
  <span class="text-highlight">unique</span>: <span class="text-eraser">&apos;100%&apos;</span>
&rbrace;;</code></pre>
          </div>
        </div>
      </div>
      
      <!-- Panel 3: Deploy -->
      <div class="horizontal-panel bg-paper-dark">
        <div class="max-w-lg text-center md:text-left">
          <div class="inline-block mb-6 px-4 py-2 bg-eraser/30 rounded-full">
            <span class="font-sketch text-xl">03</span>
          </div>
          <h3 class="text-4xl md:text-5xl font-semibold mb-6 text-ink-dark">Deploy</h3>
          <p class="text-lg text-ink-light leading-relaxed mb-8">
            We launch on enterprise-grade infrastructure. Your site is distributed globally across edge servers for the fastest possible experience, anywhere in the world.
          </p>
          <!-- Server illustration -->
          <svg class="w-full max-w-xs h-48 mx-auto md:mx-0" viewBox="0 0 240 180" fill="none">
            <!-- Globe -->
            <circle class="draw-path" data-horizontal cx="120" cy="90" r="60" stroke="#2A2A2A" stroke-width="2" fill="none"/>
            <ellipse class="draw-path" data-horizontal cx="120" cy="90" rx="60" ry="20" stroke="#B8C5D6" stroke-width="1.5" fill="none"/>
            <path class="draw-path" data-horizontal d="M120 30 Q150 90 120 150" stroke="#B8C5D6" stroke-width="1.5" fill="none"/>
            <path class="draw-path" data-horizontal d="M120 30 Q90 90 120 150" stroke="#B8C5D6" stroke-width="1.5" fill="none"/>
            <!-- Connection dots -->
            <circle cx="80" cy="60" r="4" fill="#7BA3C9"/>
            <circle cx="160" cy="70" r="4" fill="#7BA3C9"/>
            <circle cx="100" cy="120" r="4" fill="#7BA3C9"/>
            <circle cx="150" cy="110" r="4" fill="#7BA3C9"/>
            <!-- Lightning bolt -->
            <path class="draw-path" data-horizontal d="M200 50 L185 80 L200 80 L180 120" stroke="#FFF3B0" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
          </svg>
        </div>
      </div>
      
      <!-- Panel 4: Maintain -->
      <div class="horizontal-panel bg-paper">
        <div class="max-w-lg text-center md:text-left">
          <div class="inline-block mb-6 px-4 py-2 bg-sketch-blue/20 rounded-full">
            <span class="font-sketch text-xl">04</span>
          </div>
          <h3 class="text-4xl md:text-5xl font-semibold mb-6 text-ink-dark">Maintain</h3>
          <p class="text-lg text-ink-light leading-relaxed mb-8">
            We don&apos;t disappear after launch. Ongoing hosting, security updates, and analytics insights. Need changes? We&apos;re just a message away.
          </p>
          <!-- Dashboard illustration -->
          <svg class="w-full max-w-sm h-48 mx-auto md:mx-0" viewBox="0 0 300 180" fill="none">
            <!-- Dashboard frame -->
            <rect class="draw-path" data-horizontal x="20" y="20" width="260" height="140" rx="4" stroke="#2A2A2A" stroke-width="2" fill="none"/>
            <!-- Chart bars -->
            <rect class="draw-path" data-horizontal x="50" y="100" width="30" height="40" rx="2" stroke="#7BA3C9" stroke-width="2" fill="none"/>
            <rect class="draw-path" data-horizontal x="100" y="70" width="30" height="70" rx="2" stroke="#7BA3C9" stroke-width="2" fill="none"/>
            <rect class="draw-path" data-horizontal x="150" y="50" width="30" height="90" rx="2" stroke="#7BA3C9" stroke-width="2" fill="none"/>
            <rect class="draw-path" data-horizontal x="200" y="60" width="30" height="80" rx="2" stroke="#7BA3C9" stroke-width="2" fill="none"/>
            <!-- Trend line -->
            <path class="draw-path" data-horizontal d="M50 90 L100 60 L150 40 L200 50 L250 30" stroke="#E8D4D4" stroke-width="2" stroke-linecap="round" fill="none"/>
            <!-- Metrics -->
            <circle cx="250" cy="30" r="8" fill="#FFF3B0" stroke="#2A2A2A" stroke-width="1.5"/>
          </svg>
        </div>
      </div>
      
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  
  gsap.registerPlugin(ScrollTrigger);
  
  // Wait for DOM
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.querySelector('.horizontal-section') as HTMLElement;
    const panels = document.getElementById('horizontal-panels') as HTMLElement;
    
    if (container && panels) {
      const panelElements = panels.querySelectorAll('.horizontal-panel');
      const animatedPanels = new Set<number>();
      
      // Setup draw-paths for each panel
      panelElements.forEach((panel) => {
        const drawPaths = panel.querySelectorAll('.draw-path');
        
        drawPaths.forEach((path) => {
          const pathEl = path as SVGPathElement;
          
          let length: number;
          try {
            length = pathEl.getTotalLength();
          } catch {
            length = 500;
          }
          
          pathEl.style.strokeDasharray = length.toString();
          pathEl.style.strokeDashoffset = length.toString();
        });
      });
      
      // Function to animate a panel's paths
      const animatePanel = (panelIndex: number) => {
        if (animatedPanels.has(panelIndex)) return;
        animatedPanels.add(panelIndex);
        
        const panel = panelElements[panelIndex];
        const drawPaths = panel.querySelectorAll('.draw-path');
        
        drawPaths.forEach((path, pathIndex) => {
          gsap.to(path, {
            strokeDashoffset: 0,
            duration: 1.2,
            ease: 'power2.out',
            delay: pathIndex * 0.12
          });
        });
      };
      
      // Check which panels are visible and animate them
      const checkPanelVisibility = () => {
        const viewportCenter = window.innerWidth / 2;
        
        panelElements.forEach((panel, index) => {
          const rect = panel.getBoundingClientRect();
          const panelCenter = rect.left + rect.width / 2;
          
          // Trigger when panel center is within middle 60% of viewport
          const triggerZoneStart = window.innerWidth * 0.2;
          const triggerZoneEnd = window.innerWidth * 0.8;
          
          if (panelCenter >= triggerZoneStart && panelCenter <= triggerZoneEnd) {
            animatePanel(index);
          }
        });
      };
      
      // Set up horizontal scroll
      gsap.to(panels, {
        x: () => -(panels.scrollWidth - window.innerWidth),
        ease: 'none',
        scrollTrigger: {
          trigger: container,
          pin: true,
          scrub: 1,
          end: () => `+=${panels.scrollWidth - window.innerWidth}`,
          invalidateOnRefresh: true,
          onUpdate: checkPanelVisibility
        }
      });
    }
  });
</script>

<style>
  .horizontal-wrapper {
    /* Extra height for scroll distance */
    min-height: 400vh;
  }
  
  .horizontal-section {
    position: sticky;
    top: 80px;
    height: calc(100vh - 80px);
    overflow: hidden;
  }
  
  .horizontal-container {
    display: flex;
    height: 100%;
    will-change: transform;
  }
  
  .horizontal-panel {
    flex: 0 0 100vw;
    width: 100vw;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3rem;
  }
  
  @media (max-width: 768px) {
    .horizontal-wrapper {
      min-height: auto;
    }
    
    .horizontal-section {
      position: relative;
      top: 0;
      height: auto;
    }
    
    .horizontal-container {
      flex-direction: column;
    }
    
    .horizontal-panel {
      flex: none;
      width: 100%;
      height: auto;
      min-height: 100vh;
    }
  }
</style>
