---
// Footer.astro
const year = new Date().getFullYear();
---

<footer class="w-full px-6 md:px-12 py-16 border-t border-black/10 mt-32 relative z-10">
  <div class="grid grid-cols-1 md:grid-cols-3 gap-12 font-mono text-sm uppercase tracking-wider">
    <div class="flex flex-col gap-4">
      <p class="font-bold text-base">Insite</p>
      <p class="text-black/60 max-w-xs lowercase">
        Creating sites for people that make the world special.
      </p>
    </div>
    
    <div class="flex flex-col gap-4">
      <p class="font-bold">Location</p>
      <address class="not-italic text-black/60 lowercase">
        Hastings-on-Hudson<br/>
        New York
      </address>
    </div>

    <div class="flex flex-col gap-4">
      <p class="font-bold">Connect</p>
      <a href="mailto:hello@insite.com" class="text-black/60 hover:text-black hover:underline transition-colors lowercase w-fit">
        hello@insite.com
      </a>
      <a href="tel:+11234567890" class="text-black/60 hover:text-black hover:underline transition-colors lowercase w-fit">
        (123) 456-7890
      </a>
    </div>
  </div>
  
  <div class="mt-24 pt-8 border-t border-black/10 flex flex-col md:flex-row justify-between items-center gap-4 text-xs font-mono text-black/40 lowercase">
    <p>&copy; {year} insite. All rights reserved.</p>
    <div class="flex gap-6">
      <a href="#" class="hover:text-black transition-colors">built by drew and lionel</a>
    </div>
  </div>
</footer>
