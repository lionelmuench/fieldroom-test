---
// Footer.astro - Minimal footer with torn paper edge effect
---

<footer class="footer relative bg-ink-dark text-paper pt-16 pb-12 px-6">
  <!-- Torn paper edge effect at top -->
  <div class="absolute top-0 left-0 right-0 h-8 overflow-hidden -translate-y-full">
    <svg class="w-full h-full text-ink-dark" viewBox="0 0 1200 32" preserveAspectRatio="none" fill="currentColor">
      <path d="M0 32 L0 20 Q50 25 100 18 T200 22 T300 16 T400 24 T500 18 T600 20 T700 16 T800 24 T900 18 T1000 22 T1100 16 T1200 20 L1200 32 Z"/>
    </svg>
  </div>
  
  <div class="max-w-6xl mx-auto">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-8 mb-12">
      <!-- Logo -->
      <div>
        <a href="/" class="text-2xl font-semibold tracking-tight hover:text-pencil transition-colors">
          field<span class="text-pencil">room</span>
        </a>
        <p class="text-paper/60 text-sm mt-2 font-sketch text-lg">Handcrafted websites, made with care.</p>
      </div>
      
      <!-- Navigation -->
      <nav class="flex flex-wrap gap-6 text-sm">
        <a href="#about" class="text-paper/80 hover:text-paper transition-colors">About</a>
        <a href="#process" class="text-paper/80 hover:text-paper transition-colors">Process</a>
        <a href="#pricing" class="text-paper/80 hover:text-paper transition-colors">Pricing</a>
        <a href="#contact" class="text-paper/80 hover:text-paper transition-colors">Contact</a>
      </nav>
    </div>
    
    <!-- Divider -->
    <div class="border-t border-paper/10 pt-8 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <!-- Copyright -->
      <p class="text-paper/50 text-sm">
        © 2025 fieldroom. All rights reserved.
      </p>
      
      <!-- Social links -->
      <div class="flex items-center gap-6">
        <a href="https://twitter.com/fieldroom" target="_blank" rel="noopener noreferrer" class="text-paper/60 hover:text-paper transition-colors" aria-label="Twitter">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
        </a>
        <a href="https://instagram.com/fieldroom" target="_blank" rel="noopener noreferrer" class="text-paper/60 hover:text-paper transition-colors" aria-label="Instagram">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
        </a>
        <a href="mailto:hello@fieldroom.co" class="text-paper/60 hover:text-paper transition-colors" aria-label="Email">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>
