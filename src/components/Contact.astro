---
// Contact.astro - Final CTA section
---

<section class="contact relative py-32 px-6 bg-paper-dark" id="contact">
  <div class="max-w-4xl mx-auto text-center">
    <!-- Main heading -->
    <h2 class="text-4xl md:text-5xl lg:text-6xl font-semibold text-ink-dark mb-6" data-animate>
      Let's <span class="font-sketch text-5xl md:text-6xl lg:text-7xl text-pencil">make</span> something together
    </h2>
    
    <p class="text-xl text-ink-light max-w-2xl mx-auto mb-12" data-animate>
      Ready to bring your website to life? Drop us a line and let's chat about what you're building.
    </p>
    
    <!-- Email CTA -->
    <div class="space-y-6" data-animate>
      <a 
        href="mailto:hello@fieldroom.co" 
        class="btn-sketch btn-primary text-lg px-10 py-4 inline-flex"
      >
        <svg class="w-6 h-6 mr-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        hello@fieldroom.co
      </a>
      
      <p class="text-ink-light">
        <span class="font-sketch text-lg">or schedule a call</span> — we'll get back to you within 24 hours
      </p>
    </div>
    
    <!-- Trust indicators -->
    <div class="mt-20 pt-12 border-t border-paper flex flex-wrap justify-center gap-8 md:gap-16" data-animate>
      <div class="text-center">
        <p class="text-3xl font-semibold text-ink-dark">&lt;1s</p>
        <p class="text-sm text-ink-light font-sketch text-lg">avg load time</p>
      </div>
      <div class="text-center">
        <p class="text-3xl font-semibold text-ink-dark">24h</p>
        <p class="text-sm text-ink-light font-sketch text-lg">response time</p>
      </div>
    </div>
  </div>
  
  <!-- Background decorations -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden">
    <svg class="absolute top-10 right-10 w-40 h-40 text-paper opacity-50" viewBox="0 0 100 100" fill="none">
      <circle cx="50" cy="50" r="45" stroke="currentColor" stroke-width="1"/>
      <circle cx="50" cy="50" r="30" stroke="currentColor" stroke-width="1"/>
      <circle cx="50" cy="50" r="15" stroke="currentColor" stroke-width="1"/>
    </svg>
    <svg class="absolute bottom-10 left-10 w-32 h-32 text-paper opacity-40" viewBox="0 0 100 100" fill="none">
      <path d="M10 50 Q25 25 50 50 T90 50" stroke="currentColor" stroke-width="2"/>
      <path d="M10 70 Q25 45 50 70 T90 70" stroke="currentColor" stroke-width="2"/>
    </svg>
  </div>
</section>
