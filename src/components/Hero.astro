---
// Hero.astro - Massive typographic hero with hand-drawn elements
---

<section class="hero relative min-h-screen flex flex-col justify-center items-center px-6 overflow-hidden">
  <!-- Decorative doodles -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden">
    <!-- Top left squiggle -->
    <svg class="absolute top-20 left-10 w-24 h-24 text-pencil opacity-40" viewBox="0 0 100 100" fill="none">
      <path class="draw-path" d="M20 50 Q40 20 60 50 T100 50" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/>
    </svg>
    
    <!-- Right side star -->
    <svg class="absolute top-1/4 right-16 w-16 h-16 text-sketch-blue opacity-50" viewBox="0 0 50 50" fill="none">
      <path class="draw-path" d="M25 5 L30 20 L45 25 L30 30 L25 45 L20 30 L5 25 L20 20 Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" fill="none"/>
    </svg>
    
    <!-- Bottom left circles -->
    <svg class="absolute bottom-32 left-20 w-32 h-32 text-eraser opacity-30" viewBox="0 0 100 100" fill="none">
      <circle class="draw-path" cx="50" cy="50" r="40" stroke="currentColor" stroke-width="2" fill="none"/>
      <circle class="draw-path" cx="50" cy="50" r="25" stroke="currentColor" stroke-width="1.5" fill="none"/>
    </svg>
    
    <!-- Right side arrow pointing down -->
    <svg class="absolute top-1/2 right-8 w-12 h-32 text-ink-light opacity-20" viewBox="0 0 30 80" fill="none">
      <path class="draw-path" d="M15 0 L15 60 M5 50 L15 65 L25 50" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
    </svg>
  </div>

  <!-- Main hero content -->
  <div class="relative z-10 text-center max-w-6xl mx-auto">
    <!-- Small tagline above -->
    <p class="font-sketch text-2xl md:text-3xl text-ink-light mb-4 opacity-0 animate-[fade-up_0.8s_ease-out_0.2s_forwards]" data-animate>
      design studio
    </p>
    
    <!-- Massive brand name -->
    <h1 class="text-massive font-semibold tracking-tight text-ink-dark mb-8 opacity-0 animate-[fade-up_0.8s_ease-out_0.4s_forwards]">
      <span class="inline-block hover:animate-[wobble_0.6s_ease-in-out]">field</span><span class="inline-block text-pencil hover:animate-[wobble_0.6s_ease-in-out]">room</span>
    </h1>
    
    <!-- Hand-drawn underline -->
    <svg class="w-full max-w-md mx-auto h-4 mb-12 opacity-0 animate-[fade-up_0.8s_ease-out_0.5s_forwards]" viewBox="0 0 400 16" fill="none">
      <path class="draw-path" d="M0 8 Q100 2 200 10 T400 6" stroke="#2A2A2A" stroke-width="2.5" stroke-linecap="round" fill="none"/>
    </svg>
    
    <!-- Subheading -->
    <p class="text-xl md:text-2xl text-ink max-w-2xl mx-auto leading-relaxed mb-12 opacity-0 animate-[fade-up_0.8s_ease-out_0.6s_forwards]" data-animate>
      We craft <span class="font-sketch text-2xl md:text-3xl">beautiful</span>, functional websites 
      that feel <span class="sketch-underline">handmade</span>
    </p>
    
    <!-- CTA Button -->
    <div class="opacity-0 animate-[fade-up_0.8s_ease-out_0.8s_forwards]">
      <a href="#contact" class="btn-sketch btn-primary">
        Let's work together
        <svg class="w-5 h-5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 10h12M12 5l5 5-5 5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </div>
  
  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-0 animate-[fade-up_0.8s_ease-out_1s_forwards]">
    <span class="font-sketch text-lg text-ink-light">scroll down</span>
    <svg class="w-6 h-10 animate-[float_2s_ease-in-out_infinite]" viewBox="0 0 24 40" fill="none">
      <path d="M12 4 L12 30 M6 24 L12 32 L18 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-ink"/>
    </svg>
  </div>
</section>

<style>
  .hero {
    background: 
      radial-gradient(ellipse at 30% 20%, rgba(184, 197, 214, 0.1) 0%, transparent 50%),
      radial-gradient(ellipse at 70% 80%, rgba(232, 212, 212, 0.1) 0%, transparent 50%);
  }
</style>
