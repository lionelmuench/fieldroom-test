                </div>
            </div>
            <div class="p-6 md:p-8 flex justify-between items-start gap-4">
                <div class="flex flex-col gap-2">
                    <h3 class="font-display text-2xl font-bold uppercase tracking-tight">Continental Tile</h3>
                    <p class="font-mono text-sm opacity-70">Flooring Contractor</p>
                </div>
                <div class="w-10 h-10 rounded-full border-2 border-black group-hover:border-white flex items-center justify-center shrink-0 transition-transform duration-500 group-hover:rotate-45">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </div>
            </div>
        </a>

        <!-- Project 4: Scrollit -->
        <a href="https://scrollit.fyi" target="_blank" rel="noopener noreferrer" class="group flex flex-col border-2 border-black hover:bg-black hover:text-white transition-colors duration-500 bg-white shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] hover:-translate-y-2 hover:shadow-[12px_12px_0px_0px_rgba(0,0,0,1)]">
            <div class="w-full aspect-[16/9] border-b-2 border-black group-hover:border-white transition-colors relative overflow-hidden">
                <img src="/images/scrollit.png" alt="Scrollit word ladder game" class="w-full h-full object-cover object-top transition-transform duration-700 group-hover:scale-105" />
