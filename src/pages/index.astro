                    — Kerry, D.C. Crane Service
                </div>
            </div>
        </div>
      </div>

    </div>
  </section>

  <section id="about" class="py-16 md:py-24 px-4 md:px-8 border-b-2 border-black bg-white relative overflow-hidden">
    <div class="max-w-6xl mx-auto flex flex-col gap-16 relative z-10">
      
