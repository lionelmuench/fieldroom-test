---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="INSITE | Web Design">
  
  <!-- The Scroll Sequence Wrapper -->
  <div id="scroll-sequence" class="relative h-[200vh] bg-black">
    <div class="sticky top-0 h-screen w-full overflow-hidden border-b-2 border-black">
      
      <!-- THE REALITY SECTION (Background Layer) -->
      <section id="stats" class="absolute inset-0 w-full h-full flex flex-col items-center justify-center px-4 md:px-8 bg-black text-white pointer-events-auto">
        <div class="max-w-6xl mx-auto flex flex-col items-center text-center gap-12">
          <div class="font-mono text-xs uppercase tracking-widest flex items-center justify-center gap-2 text-white/50">
              <span class="inline-block w-4 h-4 bg-white rounded-full"></span>
              (The Reality)
              <span class="inline-block w-4 h-4 bg-white rounded-full"></span>
          </div>
          <div class="max-w-5xl flex flex-col gap-8 group">
            <h3 class="text-4xl md:text-6xl lg:text-7xl xl:text-8xl font-display uppercase tracking-tighter leading-[1.05] transition-all duration-300 group-hover:italic text-white">
              "84% of consumers say a business is more credible if it has a website."
            </h3>
            <p class="font-mono text-sm md:text-lg mt-4 text-white/50 uppercase tracking-widest font-semibold">— Verisign</p>
          </div>
        </div>
      </section>

      <!-- THE HERO SECTION (Foreground Layer, fades out) -->
      <section id="hero-layer" class="absolute inset-0 w-full h-full flex flex-col items-center justify-end overflow-hidden bg-white origin-top will-change-[opacity]">
        
        <div class="flex-grow flex flex-col items-center justify-center w-full relative pt-20">
          <!-- Initial White Overlay (Fades out after 1.5s) -->
          <div id="initial-overlay" class="fixed inset-0 w-screen h-screen bg-white z-[50] opacity-100 transition-opacity duration-[1500ms] pointer-events-none"></div>

          <!-- Massive Logo Centered -->
          <div id="hero-logo-wrapper" class="w-full flex items-center justify-center relative z-[60] mb-8 md:mb-12 h-[26vw] sm:h-[22vw] md:h-[18rem] pointer-events-none">
            <h1 id="hero-logo" class="text-[26vw] sm:text-[22vw] md:text-[16rem] leading-none tracking-tighter text-black select-none pointer-events-auto origin-center">
              insite
            </h1>
          </div>

          <!-- Hidden font preloader -->
          <div aria-hidden="true" class="absolute pointer-events-none opacity-0 select-none overflow-hidden w-0 h-0">
            <span style="font-family: 'Helvetica Neue', sans-serif; font-weight: 700;">insite</span>
            <span style="font-family: 'Playfair Display', serif; font-weight: 900; font-style: italic;">insite</span>
            <span style="font-family: 'Space Mono', monospace; font-weight: 400;">insite</span>
            <span style="font-family: Georgia, serif; font-weight: 400; font-style: italic;">insite</span>
            <span style="font-family: 'Arial Black', sans-serif; font-weight: 900;">insite</span>
            <span style="font-family: 'Courier New', monospace; font-weight: 700;">insite</span>
            <span style="font-family: Impact, sans-serif; font-weight: 400;">insite</span>
            <span style="font-family: 'Times New Roman', serif; font-weight: 400; font-style: italic;">insite</span>
          </div>

          <!-- Direct, non-jargon copy -->
          <p class="max-w-2xl font-display text-lg sm:text-xl md:text-2xl leading-snug uppercase tracking-tight text-black/80 font-medium text-center relative z-20 px-4 md:px-0">
            We're two college students who make really good websites. We work with local businesses and creative projects to build things that stand out.
          </p>
        </div>
        
        <!-- Bottom Scroll down indicator (shifted up above marquee) -->
        <div class="relative z-20 opacity-40 hover:opacity-100 transition-opacity duration-300 flex flex-col items-center gap-3 mb-10 md:mb-14">
            <span class="font-mono text-[10px] uppercase tracking-[0.2em] text-black">Scroll</span>
            <svg width="12" height="24" viewBox="0 0 12 24" fill="none">
                <path d="M6 0v23m0 0l-5-5m5 5l5-5" stroke="black" stroke-width="1.5"/>
            </svg>
        </div>

        <!-- Marquee Anchor Moved into Hero Bottom -->
        <div class="w-full overflow-hidden border-t-2 border-black bg-black text-white py-3 relative z-20 flex group" style="--gap: 2rem;">
          <div class="animate-marquee whitespace-nowrap font-mono text-xs md:text-sm uppercase tracking-widest flex items-center shrink-0 pr-[var(--gap)] group-hover:text-black/50 transition-colors">
            <span class="mx-4">+++</span>
            <span>Web Design</span>
            <span class="mx-4">+++</span>
            <span>Development</span>
            <span class="mx-4">+++</span>
            <span>Personal Vision</span>
            <span class="mx-4">+++</span>
            <span>Honest Labor</span>
            <span class="mx-4">+++</span>
            <span>No Bloat</span>
            <span class="mx-4">+++</span>
            <span>Built in NY</span>
          </div>
          <!-- Duplicate for seamless scrolling -->
          <div class="animate-marquee whitespace-nowrap font-mono text-xs md:text-sm uppercase tracking-widest flex items-center shrink-0 pr-[var(--gap)] group-hover:text-black/50 transition-colors" aria-hidden="true">
            <span class="mx-4">+++</span>
            <span>Web Design</span>
            <span class="mx-4">+++</span>
            <span>Development</span>
            <span class="mx-4">+++</span>
            <span>Personal Vision</span>
            <span class="mx-4">+++</span>
            <span>Honest Labor</span>
            <span class="mx-4">+++</span>
            <span>No Bloat</span>
            <span class="mx-4">+++</span>
            <span>Built in NY</span>
          </div>
          <!-- Triple redundancy for arbitrary widths -->
          <div class="animate-marquee whitespace-nowrap font-mono text-xs md:text-sm uppercase tracking-widest flex items-center shrink-0 pr-[var(--gap)] group-hover:text-black/50 transition-colors" aria-hidden="true">
            <span class="mx-4">+++</span>
            <span>Web Design</span>
            <span class="mx-4">+++</span>
            <span>Development</span>
            <span class="mx-4">+++</span>
            <span>Personal Vision</span>
            <span class="mx-4">+++</span>
            <span>Honest Labor</span>
            <span class="mx-4">+++</span>
            <span>No Bloat</span>
            <span class="mx-4">+++</span>
            <span>Built in NY</span>
          </div>
        </div>

      </section>

    </div>
  </div>

  <script>
    // Force page to always load at the top to preserve the hero animation experience
    if ('scrollRestoration' in history) {
      history.scrollRestoration = 'manual';
    }
    window.scrollTo(0, 0);
    
    // Lock scrolling during the initial fade-in
    document.body.style.overflow = 'hidden';

    // Defining optical scale adjustments for different fonts to keep them visually balanced
    const fonts = [
      { family: '"Helvetica Neue", sans-serif', weight: '700', style: 'normal', scale: 1 },
      { family: '"Playfair Display", serif', weight: '900', style: 'italic', scale: 1.15 },
      { family: '"Space Mono", monospace', weight: '400', style: 'normal', scale: 0.82 },
      { family: 'Georgia, serif', weight: '400', style: 'italic', scale: 1.1 },
      { family: '"Arial Black", sans-serif', weight: '900', style: 'normal', scale: 0.88 },
      { family: '"Courier New", monospace', weight: '700', style: 'normal', scale: 0.82 },
      { family: 'Impact, sans-serif', weight: '400', style: 'normal', scale: 1.05 },
      { family: '"Times New Roman", serif', weight: '400', style: 'italic', scale: 1.18 }
    ];
    
    const logo = document.getElementById('hero-logo');
    const overlay = document.getElementById('initial-overlay');
    
    if (logo) {
      let currentFont = 0;
      
      // Font swapping interval - snapping instantly without CSS transitions
      setInterval(() => {
        currentFont = (currentFont + 1) % fonts.length;
        const f = fonts[currentFont];
        logo.style.fontFamily = f.family;
        logo.style.fontWeight = f.weight;
        logo.style.fontStyle = f.style;
        logo.style.transform = `scale(${f.scale})`;
      }, 300);

      // Fade out the masking layer after 1.5 seconds to reveal the rest
      setTimeout(() => {
        if (overlay) {
          overlay.classList.remove('opacity-100');
          overlay.classList.add('opacity-0');
        }
        // Unlock scrolling
        document.body.style.overflow = '';
      }, 1500);
    }

    // Scroll sequence opacity logic
    requestAnimationFrame(() => {
        const sequence = document.getElementById('scroll-sequence');
        const heroLayer = document.getElementById('hero-layer');

        if (sequence && heroLayer) {
            window.addEventListener('scroll', () => {
              const rect = sequence.getBoundingClientRect();
              const windowHeight = window.innerHeight;
              
              if (rect.top <= 0 && rect.top >= -windowHeight) {
                // Calculate progress through the sticky sequence (0 to 1)
                let progress = Math.abs(rect.top) / windowHeight;
                
                // Map progress to opacity. E.g., hero fully fades out by scroll
                let opacity = 1 - (progress * 1.5);
                if (opacity < 0) opacity = 0;
                
                heroLayer.style.opacity = opacity.toString();
                
                // Disable pointer events on hero when faded so Reality is clickable
                if (opacity < 0.1) {
                    heroLayer.style.pointerEvents = 'none';
                } else {
                    heroLayer.style.pointerEvents = 'auto';
                }
              } else if (rect.top > 0) {
                heroLayer.style.opacity = '1';
                heroLayer.style.pointerEvents = 'auto';
              } else {
                heroLayer.style.opacity = '0';
                heroLayer.style.pointerEvents = 'none';
              }
            }, { passive: true });
        }
    });
  </script>

  <section id="about" class="py-16 md:py-24 px-4 md:px-8 border-b-2 border-black bg-white">
    <div class="max-w-6xl mx-auto flex flex-col gap-16">
      
      <div class="flex flex-col md:flex-row gap-8 md:gap-16 items-start border-2 border-black p-6 md:p-12 hover:bg-black hover:text-white transition-colors duration-500 group">
        <div class="font-mono text-xs uppercase tracking-widest md:w-1/5 shrink-0 pt-2 flex items-center gap-2">
            <span class="inline-block w-4 h-4 bg-black group-hover:bg-white rounded-full"></span>
            (Who we are)
        </div>
        <div class="font-mono text-sm md:text-base leading-relaxed tracking-tight">
          <p class="mb-6 border-b-2 border-black/20 pb-6">
            Hi! We're Drew and Lionel, two college students from New York studying physics, computer science, and economics. 
          </p>
          <p class="opacity-80 group-hover:opacity-100 transition-opacity">
            We started building websites because we like understanding how things work and making them better. What began as side projects turned into real work for real clients, and we’ve been doing it ever since. 
          </p>
        </div>
      </div>

      <div class="flex flex-col md:flex-row gap-8 md:gap-16 items-start border-2 border-black p-6 md:p-12 bg-gray-50">
        <div class="font-mono text-xs uppercase tracking-widest md:w-1/5 shrink-0 pt-2 flex items-center gap-2">
            <span class="inline-block w-4 h-4 border-2 border-black"></span>
            (The Mission)
        </div>
        <div class="font-mono text-sm md:text-base leading-relaxed max-w-2xl text-black/80">
          <p>
            We’ve worked with startups, nonprofits, publications, small businesses, and individuals who need a website that actually represents them well.
          </p>
          <p class="mt-6 border-l-4 pl-4 border-black text-black font-semibold">
            Our focus is simple: build thoughtful, custom sites that are fast, clean, and easy to use. We use modern, lightweight web technologies designed for speed and long-term reliability, which means better performance, fewer moving parts, and full control over how everything looks and functions.
          </p>
        </div>
      </div>

    </div>
  </section>

  <section id="services" class="py-16 md:py-24 px-4 md:px-8 border-b-2 border-black bg-black text-white">
    <div class="max-w-6xl mx-auto">
      <div class="flex flex-col md:flex-row justify-between items-end mb-12 border-b-2 border-white/20 pb-8">
        <h2 class="text-4xl md:text-6xl font-display font-medium tracking-tighter uppercase">(Services)</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 font-mono text-sm">
        
        <!-- Card 1 -->
        <div class="border-2 border-white/20 p-8 hover:border-white transition-colors duration-300 flex flex-col h-full group">
            <div class="text-xs opacity-50 mb-8 flex justify-between">
                <span>01</span>
                <span>[ Build ]</span>
            </div>
            <h3 class="text-2xl font-display uppercase tracking-tight mb-4 group-hover:italic">Web Design & Dev</h3>
            <p class="opacity-70 flex-grow">
                Fast, responsive, and completely custom websites built from scratch. No bloat, no templates, total performance.
            </p>
            <div class="h-1 w-0 bg-white group-hover:w-full transition-all duration-500 mt-8"></div>
        </div>

        <!-- Card 2 -->
        <div class="border-2 border-white/20 p-8 hover:border-white transition-colors duration-300 flex flex-col h-full group">
            <div class="text-xs opacity-50 mb-8 flex justify-between">
                <span>02</span>
                <span>[ Optimize ]</span>
            </div>
            <h3 class="text-2xl font-display uppercase tracking-tight mb-4 group-hover:italic">Redesigns & SEO</h3>
            <p class="opacity-70 flex-grow">
                Modernizing outdated digital presences to improve technical performance, search rankings, and user experience.
            </p>
            <div class="h-1 w-0 bg-white group-hover:w-full transition-all duration-500 mt-8"></div>
        </div>

        <!-- Card 3 -->
        <div class="border-2 border-white/20 p-8 hover:border-white transition-colors duration-300 flex flex-col h-full group">
            <div class="text-xs opacity-50 mb-8 flex justify-between">
                <span>03</span>
                <span>[ Manage ]</span>
            </div>
            <h3 class="text-2xl font-display uppercase tracking-tight mb-4 group-hover:italic">Ongoing Support</h3>
            <p class="opacity-70 flex-grow">
                We handle the hosting, updates, and maintenance so you have a seamless digital presence without the headache.
            </p>
            <div class="h-1 w-0 bg-white group-hover:w-full transition-all duration-500 mt-8"></div>
        </div>

      </div>
    </div>
  </section>

  <section id="work" class="py-16 md:py-24 px-4 md:px-8 border-b-2 border-black bg-white">
    <div class="max-w-6xl mx-auto flex flex-col gap-16">
      
      <div class="flex flex-col md:flex-row justify-between items-end border-b-2 border-black pb-8">
        <h2 class="text-4xl md:text-6xl font-display font-medium tracking-tighter uppercase">(Selected Works)</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        
        <!-- Project 1 -->
        <div class="border-2 border-black group overflow-hidden bg-black text-white flex flex-col">
          <div class="aspect-[4/3] w-full bg-[#f4f4f4] border-b-2 border-black p-8 flex flex-col justify-center items-center text-center relative overflow-hidden transition-all duration-500">
            <div class="absolute inset-0 bg-white/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500 z-10 pointer-events-none"></div>
            <h4 class="font-display text-4xl text-black mb-2 uppercase tracking-tighter relative z-20 transition-transform duration-500 group-hover:scale-110">Continental Tile</h4>
            <div class="font-mono text-black/50 text-xs uppercase tracking-widest relative z-20 mt-4">( Local Business )</div>
          </div>
          <div class="p-6">
            <h3 class="text-2xl font-display uppercase tracking-tight mb-2 group-hover:italic transition-all duration-300">Continental Tile</h3>
            <div class="font-mono text-xs opacity-70 flex flex-wrap gap-4 mt-6 border-t border-white/20 pt-4">
                <span>[ Web Design ]</span>
                <span>[ Development ]</span>
                <span>[ Copywriting ]</span>
            </div>
          </div>
        </div>

        <!-- Project 2 -->
        <div class="border-2 border-black group overflow-hidden bg-black text-white flex flex-col">
          <div class="aspect-[4/3] w-full bg-[#f4f4f4] border-b-2 border-black p-8 flex flex-col justify-center items-center text-center relative overflow-hidden transition-all duration-500">
            <div class="absolute inset-0 bg-white/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500 z-10 pointer-events-none"></div>
            <h4 class="font-display text-4xl text-black mb-2 uppercase tracking-tighter relative z-20 transition-transform duration-500 group-hover:scale-110">D C Crane</h4>
            <div class="font-mono text-black/50 text-xs uppercase tracking-widest relative z-20 mt-4">( Corporate Redesign )</div>
          </div>
          <div class="p-6">
            <h3 class="text-xl md:text-2xl font-display uppercase tracking-tight mb-2 group-hover:italic transition-all duration-300">D C Crane</h3>
            <div class="font-mono text-xs opacity-70 flex flex-wrap gap-4 mt-6 border-t border-white/20 pt-4">
                <span>[ Complete Redesign ]</span>
                <span>[ Architecture ]</span>
            </div>
          </div>
        </div>

      </div>

    </div>
  </section>

  <section id="contact" class="py-24 px-4 md:px-8 border-t-2 border-black flex items-center justify-center text-center bg-[#f4f4f4]">
    <div class="border-2 border-black p-12 md:p-24 relative overflow-hidden group w-full max-w-4xl bg-white flex flex-col items-center">
      <div class="absolute inset-0 bg-black translate-y-full group-hover:translate-y-0 transition-transform duration-700 ease-in-out"></div>
      
      <h2 class="text-4xl md:text-6xl lg:text-7xl font-display font-medium uppercase tracking-tighter relative z-10 group-hover:text-white transition-colors duration-500 delay-100">
        <a href="mailto:createwithinsite@gmail.com" class="hover:italic inline-block">Start a project.</a>
      </h2>
      
      <p class="font-mono text-sm md:text-base text-black/60 mt-6 relative z-10 group-hover:text-white/80 transition-colors duration-500 delay-150 max-w-md">
        Reach out to discuss your timelines, goals, and how we can add measurable value to your business.
      </p>

      <div class="mt-12 flex justify-center gap-4 relative z-10 group-hover:text-white transition-colors duration-500 delay-200">
          <a href="mailto:createwithinsite@gmail.com" class="font-mono text-sm tracking-widest border-2 border-black group-hover:border-white group-hover:bg-white group-hover:text-black py-3 px-6 hover:bg-black hover:text-white transition-colors">createwithinsite@gmail.com</a>
      </div>
    </div>
  </section>

</BaseLayout>


<style>
/* Add the marquee animation to the scoped styles so it works correctly */
@keyframes marquee {
  0% { transform: translateX(0); }
  100% { transform: translateX(calc(-100% - var(--gap))); }
}

.animate-marquee {
  animation: marquee 20s linear infinite;
}
</style>
