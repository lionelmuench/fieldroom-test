                <span>[ Evolution ]</span>
            </div>
            <h3 class="text-2xl font-display uppercase tracking-tight mb-4 group-hover:italic relative z-10">Redesigns</h3>
            <p class="opacity-70 flex-grow relative z-10">
                Modernizing outdated digital presences while keeping what works and improving what doesn't.
            </p>
        </div>

        <!-- Card 3 -->
        <div class="relative border-2 border-white/20 p-8 flex flex-col h-full group bg-black cursor-pointer">
            <!-- Animated Drawing Inner Box -->
            <span class="absolute top-2 left-2 w-0 h-[2px] bg-white transition-all duration-500 ease-out group-hover:w-[calc(100%-16px)] pointer-events-none z-0"></span>
            <span class="absolute bottom-2 right-2 w-0 h-[2px] bg-white transition-all duration-500 ease-out group-hover:w-[calc(100%-16px)] pointer-events-none z-0"></span>
            <span class="absolute top-2 right-2 w-[2px] h-0 bg-white transition-all duration-500 ease-out group-hover:h-[calc(100%-16px)] pointer-events-none z-0"></span>
            <span class="absolute bottom-2 left-2 w-[2px] h-0 bg-white transition-all duration-500 ease-out group-hover:h-[calc(100%-16px)] pointer-events-none z-0"></span>

            <div class="text-xs opacity-50 mb-8 flex justify-between relative z-10">
                <span>03</span>
                <span>[ Fidelity ]</span>
            </div>
            <h3 class="text-2xl font-display uppercase tracking-tight mb-4 group-hover:italic relative z-10">Personal Vision</h3>
            <p class="opacity-70 flex-grow relative z-10">
                We work closely with you throughout the process, making sure the final site reflects your vision completely.
            </p>
        </div>

      </div>
    </div>
  </section>

  <section id="portfolio" class="py-16 md:py-24 px-4 md:px-8 border-b-2 border-black bg-gray-50">
    <div class="max-w-6xl mx-auto flex flex-col gap-12 md:gap-16">
      
