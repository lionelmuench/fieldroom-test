            <span class="font-mono text-xs uppercase tracking-[0.3em] text-black/40 whitespace-nowrap" style="writing-mode: vertical-rl; transform: rotate(180deg);">Who We Are</span>
            <span class="block w-2 h-2 rounded-full bg-black/20"></span>
        </div>
    </div>

    <!-- Right Marginalia Line -->
    <div class="hidden xl:block absolute right-8 2xl:right-16 top-0 bottom-0 w-[2px] bg-black/10 pointer-events-none">
        <!-- Floating Text Marker -->
        <div class="absolute top-1/2 -translate-y-1/2 -right-6 flex flex-col items-center gap-4">
            <span class="block w-2 h-2 rounded-full bg-black/20"></span>
            <span class="font-mono text-xs uppercase tracking-[0.3em] text-black/40 whitespace-nowrap" style="writing-mode: vertical-rl;">Who We Are</span>
