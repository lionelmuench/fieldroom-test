                    <div class="font-display text-2xl md:text-4xl uppercase tracking-tighter text-white transition-opacity duration-500 opacity-0 group-hover:opacity-100">View Project</div>
                </div>
            </div>
            <div class="p-6 md:p-8 flex justify-between items-start gap-4">
                <div class="flex flex-col gap-2">
                    <h3 class="font-display text-2xl font-bold uppercase tracking-tight">Scrollit</h3>
