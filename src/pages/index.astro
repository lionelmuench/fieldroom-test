---
// index.astro - Main homepage
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import HorizontalShowcase from '../components/HorizontalShowcase.astro';
import Pricing from '../components/Pricing.astro';
import Testimonials from '../components/Testimonials.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="fieldroom — Handcrafted Websites for Small Businesses"
  description="We create beautiful, lightning-fast static websites for individuals and small businesses. Unique designs, SEO optimization, hassle-free hosting. Starting at $150/month."
>
  <main>
    <Hero />
    <About />
    <HorizontalShowcase />
    <Pricing />
    <Testimonials />
    <Contact />
  </main>
  <Footer />
</BaseLayout>
