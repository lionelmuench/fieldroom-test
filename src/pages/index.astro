        <a href="https://susanpdominus.com" target="_blank" rel="noopener noreferrer" class="group flex flex-col border-2 border-black hover:bg-black hover:text-white transition-colors duration-500 bg-white shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] hover:-translate-y-2 hover:shadow-[12px_12px_0px_0px_rgba(0,0,0,1)]">
